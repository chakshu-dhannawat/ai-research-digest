DB_HOST=db
DB_PORT=5432
DB_USER=newsletter
DB_PASSWORD=newsletter
DB_NAME=newsletter

GITHUB_TOKEN=

# Primary LLM: Qwen3.5 on difgpu01 (128k context)
LLM_BASE_URL=http://difgpu01.tdc.otsuka-shokai.co.jp:9000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-122B-A10B

# Fallback LLM: MiniMax-M3 on difgpu01 (used if primary endpoint is down)
LLM_FALLBACK_BASE_URL=http://difgpu01.tdc.otsuka-shokai.co.jp:9003/v1
LLM_FALLBACK_MODEL=MiniMaxAI/MiniMax-M3-MXFP8

# DISABLED — DeepSeek on macdep01:8001 must NOT be used (kept for reference):
# LLM_BASE_URL=http://macdep01.tdc.otsuka-shokai.co.jp:8001/v1
# LLM_MODEL=Why-LLM

# Secondary LiteLLM foundry endpoint (MiMo-V2.5) — kept for ad-hoc use
ANTHROPIC_FOUNDRY_BASE_URL=http://macdep01.tdc.otsuka-shokai.co.jp:8008/
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_MODEL=anthropic-MiMo-V2.5

SMTP_HOST=mta-fm21.otsuka-shokai.co.jp
SMTP_PORT=25
SENDER_EMAIL=chakshu@otsuka-shokai.co.jp
ALERT_EMAIL=chakshu@otsuka-shokai.co.jp
DEFAULT_RECIPIENTS=chakshu@otsuka-shokai.co.jp,rahil@otsuka-shokai.co.jp,naman@otsuka-shokai.co.jp

# Microsoft Teams channel Incoming Webhook URL. Leave empty to keep email-only delivery.
TEAMS_WEBHOOK_URL=

HTTP_PROXY=http://proxy.otsuka-shokai.co.jp:8080
NO_PROXY=localhost,127.0.0.1,db,difgpu01.tdc.otsuka-shokai.co.jp,macdep01.tdc.otsuka-shokai.co.jp,mta-fm21.otsuka-shokai.co.jp,mta-fm22.otsuka-shokai.co.jp,10.0.0.0/8,.otsuka-shokai.co.jp

CRON_HOUR=7
CRON_MINUTE=50
TOP_N_ITEMS=10
DEDUP_WINDOW_DAYS=14

# Article recency: items older than this many days are dropped before scoring (default 45 = ~6 weeks)
MAX_ARTICLE_AGE_DAYS=45
