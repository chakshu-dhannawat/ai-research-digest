# Database (used by compose.yml; defaults match the Postgres service)
DB_HOST=db
DB_PORT=5432
DB_USER=newsletter
DB_PASSWORD=newsletter
DB_NAME=newsletter

# GitHub personal access token (no scopes required for public repo search,
# but a token raises rate limits dramatically)
GITHUB_TOKEN=

# Primary LLM endpoint for scoring and summarization.
# Must be OpenAI-compatible (e.g. vLLM, TGI, LiteLLM, OpenAI, etc.)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# Fallback LLM endpoint used when the primary is unreachable.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# Optional ad-hoc LiteLLM / foundry endpoint (used only if explicitly called)
ANTHROPIC_FOUNDRY_BASE_URL=
ANTHROPIC_FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# SMTP relay for email delivery
SMTP_HOST=localhost
SMTP_PORT=25
SENDER_EMAIL=newsletter@example.com
ALERT_EMAIL=admin@example.com
DEFAULT_RECIPIENTS=newsletter@example.com

# Microsoft Teams channel Incoming Webhook URL. Leave empty for email-only delivery.
TEAMS_WEBHOOK_URL=

# Corporate proxy (leave empty if direct internet access is available)
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=localhost,127.0.0.1,db
no_proxy=localhost,127.0.0.1,db

# Scheduler
CRON_HOUR=7
CRON_MINUTE=50

# Pipeline tuning
TOP_N_ITEMS=10
DEDUP_WINDOW_DAYS=14

# Article recency: items older than this many days are dropped before scoring
MAX_ARTICLE_AGE_DAYS=45
